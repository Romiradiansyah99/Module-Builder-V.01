# ============================================================
# KONFIGURASI KEMNAKER MODULE BUILDER
# Salin file ini ke `.env` lalu isi nilai aslinya.
# Semua path relatif di-resolve terhadap root proyek.
# ============================================================

# --- LLM (Ollama Cloud via API key — tanpa Ollama desktop) ---
# Protokol native Ollama (/api/chat) + Bearer key; tidak perlu ubah kode.
LLM_BASE_URL=https://ollama.com
LLM_API_KEY=GANTI_DENGAN_API_KEY_BARU
LLM_MODEL=deepseek-v4.1-flash:cloud
# Model chat ringan (effort "low") untuk percakapan dig Agent 1
LLM_MODEL_FAST=deepseek-v4.1-flash:cloud

# --- Embeddings ---
# PENTING untuk VPS: biarkan EMBEDDING_MODEL KOSONG agar dipakai embedder
# lokal ONNX (all-MiniLM) yang COCOK dengan index chroma_db yang
# disertakan. Bila diisi kandidat remote, RAG terdegradasi SENYAP
# (query pakai embedder beda dengan index) walau semua terlihat normal.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# --- RAG / vector store ---
SKKNI_DOCS_DIR=database/skkni_docs
CHROMA_DB_DIR=database/chroma_db
CHROMA_COLLECTION=skkni_kemnaker
RAG_TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Batas waktu tunggu ingest RAG di server (detik)
RAG_WAIT_TIMEOUT=60

# --- Path dokumen konteks ---
TEMPLATE_PATH=database/template_kemnaker.docx
PROGRAM_DOC_PATH=database/program/Program_Pelatihan_PLTSa_Revisi_Kemenaker.docx
EXAMPLE_MODULES_DIR=database/contoh_modul
OUTPUT_DIR=output
UPLOADS_DIR=database/uploads
AI_MEMORY_PATH=database/ai_memory.json

# --- Server binding ---
# Lokal: biarkan default (127.0.0.1:8000). VPS/Docker: HOST=0.0.0.0
HOST=127.0.0.1
PORT=8000

# --- Auth kata sandi tunggal ---
# Hash SHA-256 dari kata sandi tim (hex). Buat dengan:
#   python -c "import hashlib;print(hashlib.sha256(b'SANDI_ANDA').hexdigest())"
# (Alternatif dev: isi APP_PASSWORD polos — di-hash otomatis saat boot,
#  tapi JANGAN dipakai di produksi.)
APP_PASSWORD_SHA256=
APP_PASSWORD=
# Secret penanda tangan cookie sesi: openssl rand -hex 32
SESSION_SECRET=GANTI_DENGAN_RANDOM_64HEX
# Set 1 bila di belakang HTTPS (Caddy) — cookie jadi Secure
COOKIE_SECURE=0

# --- Persistensi runtime (dipakai di volume Docker) ---
CHECKPOINT_DB=runtime/checkpoints.sqlite
SESSIONS_FILE=runtime/sessions.json

# --- Batas konkurensi produksi (proteksi belanja LLM) ---
PRODUCE_CONCURRENCY=2

# --- RAG CHAT (tanya jawab atas dokumen) ---
# Collection rag_chat (terpisah dari skkni_kemnaker; keduanya di-queri saat
# tanya). Embedding memakai EMBEDDING_* yang sama dgn Agent 1.
RAG_CHAT_COLLECTION=rag_chat
RAG_TOP_K_CHAT=6
# Strategi konteks-overflow: create-and-refine | tree-summarization
RAG_CONTEXT_STRATEGY=create-and-refine
# Ambang panjang konteks mentah sebelum strategi dipakai (karakter)
RAG_CONTEXT_MAX_CHARS=8000
# Klip riwayat percakapan RAG (turns percakapan dan karakter total)
RAG_HISTORY_MAX_TURNS=6
RAG_HISTORY_MAX_CHARS=4000
# Temperatur & batas token jawaban RAG
RAG_ANSWER_TEMPERATURE=0.3
RAG_ANSWER_MAX_TOKENS=16000
RAG_REFINE_MAX_TOKENS=6000
# Program docx aktif yang otomatis di-index utk RAG chat
RAG_PROGRAM_DOC_PATH=database/program/Program_Pelatihan_PLTSa_Revisi_Kemenaker.docx

# --- KB REFERENSI (template + contoh modul sebagai data RAG) ---
# Collection ketiga, TERPISAH dari skkni_kemnaker & rag_chat. Isinya dokumen
# referensi tetap: template_kemnaker.docx (source_type "template") dan isi
# database/contoh_modul/ (source_type "contoh_modul"). Bersama skkni_kemnaker
# inilah yang menjawab "SKKNI dan template adalah data untuk RAG".
#
# WAJIB dijalankan SEBELUM `docker compose build` karena
# database/chroma_db/ ikut di-ship di dalam image:
#     python -m rag.kb            # idempoten; run ke-2 tidak embed ulang
#     python tools/rag_verify.py  # bukti vektor 384-d ada & bisa dicari
RAG_KB_COLLECTION=template_kemnaker
# Slot KB di hasil gabungan rag_retrieve (kecil: korpus template hanya ~8
# chunk dan skor MiniLM tinggi -> k besar akan menggeser SKKNI).
RAG_TOP_K_KB=2
# Ingest KB otomatis saat server boot (0 = hanya manual lewat `python -m rag.kb`).
RAG_KB_INGEST_ON_BOOT=1
# Masukkan dokumen program ke KB juga. Biarkan 0: ia SUDAH ter-index di
# rag_chat sebagai doc_id "program" -> duplikat mengisi top-k dgn chunk sama.
RAG_KB_INCLUDE_PROGRAM=0

# --- GENERATE GAMBAR (Replicate) ---
# Token Replicate. TANPA INI semua gambar jatuh ke pencarian gambar internet
# (fallback) dan cover tetap memakai foto template. Ambil di
# https://replicate.com/account/api-tokens ; jangan pernah di-commit.
REPLICATE_API_TOKEN=
# === DUA TINGKAT: model subbab (banyak gambar) != model cover (sekali) ===
# Subbab memakai flux-schnell: ~$0.003/gambar, ~11x lebih murah dari
# nano-banana-2 (~$0.039) yang dipakai ronde 18, dan dipanggil berkali-kali
# per modul. Cover memakai nano-banana-2 karena flux TIDAK BISA cukup besar:
# `megapixels` mentok di "1" (1 MP) -> cover 10:7 hasil crop hanya ~1167x817 px,
# LEBIH KECIL dari foto template yang digantikannya (1400x980 px = 173 dpi
# pada lebar 205.9 mm). nano-banana menerima `resolution` 2K.
# PENTING - SKEMA INPUT BEDA PER MODEL, dan field milik model lain = HTTP 422:
#   flux-schnell  : aspect_ratio, megapixels ("1"|"0.25"), output_format,
#                   output_quality, num_outputs, go_fast. TIDAK ada `resolution`.
#   nano-banana-2 : aspect_ratio, resolution (1K|2K|4K). TIDAK ada `megapixels`.
# tools/image_gen.py memilih payload dari SLUG model yang dipanggil. Jadi isi
# kedua baris itu dengan model apa pun; payload tiap panggilan menyesuaikan
# sendiri. Mengisi keduanya dgn slug yang SAMA = kembali ke perilaku satu
# model (ronde 19) - sah, tapi cover flux akan lebih kecil dari template.
# Verifikasi KEDUA model GRATIS tanpa memakai kredit:
#     python tools/image_verify.py --schema
REPLICATE_MODEL=black-forest-labs/flux-schnell
REPLICATE_MODEL_COVER=google/nano-banana-2
# Sumber gambar utk SUBBAB:
#   replicate = SELALU Replicate dulu, cari internet hanya jaring pengaman
#   search    = foto internet dulu, Replicate sbg fallback
#   auto      = ikuti mode per-query dari Agent 2 (perilaku lama)
IMAGE_MODE=replicate
# Rasio gambar subbab (kotak template 135x100 mm ~ 4:3).
# "4:3" dan "3:2" (dipakai cover) ada di enum flux-schnell.
IMAGE_ASPECT=4:3
# Ukuran utk flux-schnell: "1" atau "0.25" (maks 1 MP).
# CATATAN: pada 1 MP, cover 10:7 hasil crop ~1167x817 px - lebih kecil dari
# foto template. Itulah alasan cover memakai model lain (lihat di atas).
IMAGE_MEGAPIXELS=1
# Kualitas JPEG 0-100 (hanya utk jpg/webp; png diabaikan).
IMAGE_OUTPUT_QUALITY=90
# Format berkas gambar SUBBAB: png (default) | jpg.
#   png = lossless, tapi berat: 1 modul dgn 21 gambar ~ 10 MB, dan tiap
#         approve/produksi mengangkut berkas sebesar itu ke browser.
#   jpg = quality 88 + optimize -> dokumen ~ 2 MB. Isi gambar adalah ILUSTRASI
#         FOTO di kotak 135x100 mm, jadi penurunan mutunya tidak kasat mata.
# Hanya png|jpg (webp ditolak python-docx). Cover SELALU jpg - tidak terpengaruh.
# CATATAN BIAYA: format ikut jadi kunci cache, jadi menggantinya membuat cache
# lama tidak terpakai SEKALI (generate ulang = panggilan Replicate berbayar).
IMAGE_OUTPUT_FORMAT=png
# Percobaan ulang saat GANGGUAN JARINGAN ke Replicate (ConnectTimeout /
# ReadTimeout / handshake TLS gagal) - bukan saat model menjawab error 4xx/5xx
# (itu bug payload/model, tak berguna diulang). Default 3 (jeda 2s lalu 4s).
# Tanpa ini, gangguan sekejap menurunkan mutu SENYAP: satu ConnectTimeout
# terbukti membuat COVER jatuh ke foto template dan satu ReadTimeout membuat
# gambar subbab jatuh ke foto internet.
IMAGE_NET_RETRIES=3
# Ukuran utk keluarga nano-banana (dipakai HANYA bila modelnya gemini).
IMAGE_RESOLUTION=1K
# Resolusi cover (satu-satunya gambar besar; dipanggil sekali per modul).
# Cover diminta 3:2 lalu di-crop lokal ke 10:7; 2K terukur memberi 2528x1696 px
# yang di-crop ke 2423x1696 (~299 dpi pada 205,9 mm) - lebih tajam dari
# template 1400x980 px (~173 dpi) dan jauh di atas cover flux (~144 dpi).
# Kosong tetap berarti 2K; isi 1K bila ingin lebih murah/mirip IMAGE_RESOLUTION.
IMAGE_COVER_RESOLUTION=2K
# Paksa keluarga skema bila deteksi otomatis salah (model tak dikenal):
# auto | flux | gemini | generic. "generic" hanya mengirim
# prompt + aspect_ratio + output_format (irisan teraman).
# Hanya berlaku utk slug yang TIDAK dikenal - slug yang dikenal selalu menang,
# supaya satu nilai di sini tak bisa merusak model yang jelas keluarga lain.
IMAGE_MODEL_FAMILY=auto
IMAGE_MODEL_FAMILY_COVER=auto
# Cover page: replicate = tukar byte word/media/image3.jpg dgn ilustrasi
# Replicate (posisi/ukuran template TIDAK berubah); template = biarkan foto
# asli template (kill switch bila Replicate sedang bermasalah).
IMAGE_COVER_MODE=replicate
# Gambar per SUB-SUBBAB pengetahuan (ronde 18): selain satu gambar per subbab
# elemen, dokumen juga memuat gambar utk tiap sub-subbab yang menyebut
# alat/APD/bahan (helm, sepatu safety, alat tulis, kertas, lembar instruksi
# kerja) - menjawab komentar reviewer "lebih banyak gambar yang menjelaskan
# keperluan atau alat kerja". 1 = aktif (default), 0 = kembali ke perilaku
# ronde 16 (satu gambar per subbab elemen saja).
# CATATAN BIAYA: tiap gambar = satu panggilan Replicate berbayar; hasilnya
# di-cache di IMAGE_CACHE_DIR sehingga approve-ulang tidak membayar dua kali.
IMAGE_SUBBAB_ENABLED=1
# Cache hasil generate (di bawah runtime/ -> ikut volume, tahan restart).
IMAGE_CACHE_DIR=runtime/image_cache